{
  "expo": {
    "name": "Genshin Dex",
    "slug": "anime_picture",
    "scheme": "genshindex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gi_dex_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gi_dex_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.haonguyen279z.genshin_dex"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "c5cdf951-bfb2-4956-a946-002327c421d6"
      }
    },
    "owner": "haonguyen279z"
  }
}
