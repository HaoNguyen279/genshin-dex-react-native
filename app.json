{
  "expo": {
    "name": "Genshin Dex",
    "slug": "genshin-dex",
    "scheme": "genshin-dex",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/gi_dex_icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gi_dex_icon_without_bg.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haonguyen279z.genshindex",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight",
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/gi_dex_icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.haonguyen279z.genshin_dex"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-screen-orientation",
      "@react-native-google-signin/google-signin"
    ],
    "owner": "haonguyen279z",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "37df6184-b0ae-4ce6-8e66-9482be696239"
      }
    }
  }
}
